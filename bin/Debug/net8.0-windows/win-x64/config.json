{
  "app": {
    "enableOnStartup": true,
    "minimizeToTray": true,
    "logLevel": "Info",
    "logsToKeepDays": 30
  },
  "analysis": {
    "tokenCountThreshold": {
      "haikuMax": 150,
      "sonnetMin": 300
    },
    "keywords": {
      "haiku": [
        "summarize",
        "extract",
        "list",
        "fact",
        "code snippet",
        "quick",
        "simple",
        "brief",
        "short"
      ],
      "sonnet": [
        "analyze",
        "compare",
        "design",
        "debug",
        "complex",
        "explain",
        "reason",
        "architecture",
        "refactor",
        "optimize"
      ]
    },
    "scoringWeights": {
      "tokenCount": 0.4,
      "keywords": 0.5,
      "userOverride": 0.1
    },
    "confidenceThreshold": 0.6
  },
  "modelSelection": {
    "throttleMs": 500,
    "inputMethod": "hybrid",
    "methods": {
      "clipboard": {
        "enabled": true,
        "restoreClipboard": true
      },
      "keyboard": {
        "enabled": false,
        "tabCount": 5,
        "timeoutMs": 2000
      },
      "flaui": {
        "enabled": true
      }
    },
    "popup": {
      "showConfirmation": true,
      "autoAcceptConfidence": 0.85,
      "timeoutMs": 5000
    }
  },
  "keyboard": {
    "interceptEnter": true,
    "interceptShiftEnter": false,
    "globalHookEnabled": true
  },
  "logging": {
    "events": {
      "hookFired": true,
      "promptRead": true,
      "analysis": true,
      "modelSelection": true,
      "errors": true
    }
  }
}
